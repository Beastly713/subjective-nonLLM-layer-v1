generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model IdempotencyRecord {
  id                 String   @id @default(uuid()) @db.Uuid
  actorId            String   @map("actor_id") @db.Uuid
  action             String   @db.VarChar(128)
  idempotencyKey     String   @map("idempotency_key") @db.VarChar(255)
  requestPayloadHash String   @map("request_payload_hash") @db.VarChar(128)
  responseStatus     Int?     @map("response_status")
  responseSnapshot   Json?    @map("response_snapshot")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt          DateTime @map("expires_at") @db.Timestamptz(6)
  actor              User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([actorId, action, idempotencyKey], map: "idempotency_records_actor_action_key_key")
  @@index([expiresAt], map: "idempotency_records_expires_at_idx")
  @@map("idempotency_records")
}

model PatientProcessingLock {
  patientId String         @id @map("patient_id") @db.Uuid
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  profile   PatientProfile @relation(fields: [patientId], references: [patientId], onDelete: Restrict)

  @@map("patient_processing_locks")
}

model AuditEvent {
  eventId                 String   @id @default(uuid()) @map("event_id") @db.Uuid
  actorId                 String?  @map("actor_id") @db.Uuid
  actorRole               String?  @map("actor_role") @db.VarChar(64)
  actorContext            Json?    @map("actor_context")
  action                  String   @db.VarChar(128)
  entityType              String   @map("entity_type") @db.VarChar(128)
  entityId                String?  @map("entity_id") @db.VarChar(255)
  patientId               String?  @map("patient_id") @db.Uuid
  occurredAt              DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  reason                  String?  @db.Text
  ruleSetVersion          String?  @map("rule_set_version") @db.VarChar(128)
  instrumentVersion       String?  @map("instrument_version") @db.VarChar(64)
  configurationVersion    String?  @map("configuration_version") @db.VarChar(128)
  sourceRevisionReference String?  @map("source_revision_reference") @db.VarChar(255)
  metadata                Json?
  requestId               String?  @map("request_id") @db.VarChar(128)

  @@index([patientId, occurredAt], map: "audit_events_patient_id_occurred_at_idx")
  @@index([entityType, entityId, occurredAt], map: "audit_events_entity_occurred_at_idx")
  @@index([actorId, occurredAt], map: "audit_events_actor_id_occurred_at_idx")
  @@map("audit_events")
}

model OperationalIncident {
  id                  String    @id @default(uuid()) @db.Uuid
  incidentType        String    @map("incident_type") @db.VarChar(128)
  code                String    @db.VarChar(128)
  status              String    @db.VarChar(64)
  summary             String    @db.Text
  metadata            Json?
  requestId           String?   @map("request_id") @db.VarChar(128)
  provenanceReference String?   @map("provenance_reference") @db.VarChar(255)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  resolvedAt          DateTime? @map("resolved_at") @db.Timestamptz(6)

  @@index([status, createdAt], map: "operational_incidents_status_created_at_idx")
  @@map("operational_incidents")
}

model User {
  id                   String                       @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  name                 String
  email                String                       @unique
  emailVerified        Boolean                      @default(false)
  image                String?
  createdAt            DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                     @updatedAt @db.Timestamptz(6)
  twoFactorEnabled     Boolean?                     @default(false)
  sessions             Session[]
  accounts             Account[]
  twoFactors           TwoFactor[]
  applicationAccount   ApplicationAccount?
  roleAssignments      UserRoleAssignment[]
  patientProfile       PatientProfile?
  clinicianAssignments ClinicianPatientAssignment[] @relation("ClinicianAssignments")
  patientAssignments   ClinicianPatientAssignment[] @relation("PatientAssignments")
  idempotencyRecords   IdempotencyRecord[]

  @@map("user")
}

model Session {
  id        String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  expiresAt DateTime @db.Timestamptz(6)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(6)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  secret                  String
  backupCodes             String
  userId                  String    @db.Uuid
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime? @db.Timestamptz(6)

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

enum ApplicationAccountState {
  PENDING
  ACTIVE
  DISABLED
}

enum ApplicationWorkspace {
  PATIENT
  CLINICIAN
  ADMIN
}

enum ApplicationRole {
  PATIENT
  CLINICIAN
  ADMIN
  OPERATIONS
}

enum MutualHelpPreference {
  NONE
  AA_12_STEP
  ALTERNATIVE
  UNSURE
  PREFER_NOT_TO_SAY
}

enum SpiritualContentPreference {
  ALLOW
  DO_NOT_ALLOW
  UNSURE
}

model ApplicationAccount {
  userId                                  String                  @id @map("user_id") @db.Uuid
  state                                   ApplicationAccountState @default(PENDING)
  version                                 Int                     @default(1)
  createdAt                               DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  createdByUserId                         String                  @map("created_by_user_id") @db.Uuid
  disabledAt                              DateTime?               @map("disabled_at") @db.Timestamptz(6)
  disabledByUserId                        String?                 @map("disabled_by_user_id") @db.Uuid
  disableReason                           String?                 @map("disable_reason") @db.Text
  privilegedIdentityVerifiedAt            DateTime?               @map("privileged_identity_verified_at") @db.Timestamptz(6)
  privilegedIdentityVerifiedByUserId      String?                 @map("privileged_identity_verified_by_user_id") @db.Uuid
  privilegedIdentityVerificationReference String?                 @map("privileged_identity_verification_reference") @db.VarChar(255)
  user                                    User                    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("application_accounts")
}

model UserRoleAssignment {
  id              String               @id @default(uuid()) @db.Uuid
  userId          String               @map("user_id") @db.Uuid
  workspace       ApplicationWorkspace
  role            ApplicationRole
  version         Int                  @default(1)
  grantedAt       DateTime             @default(now()) @map("granted_at") @db.Timestamptz(6)
  grantedByUserId String               @map("granted_by_user_id") @db.Uuid
  grantReason     String               @map("grant_reason") @db.Text
  revokedAt       DateTime?            @map("revoked_at") @db.Timestamptz(6)
  revokedByUserId String?              @map("revoked_by_user_id") @db.Uuid
  revokeReason    String?              @map("revoke_reason") @db.Text
  user            User                 @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt], map: "user_role_assignments_user_active_idx")
  @@map("user_role_assignments")
}

model PatientProfile {
  patientId          String                      @id @map("patient_id") @db.Uuid
  monitoringTimezone String                      @map("monitoring_timezone") @db.VarChar(255)
  version            Int                         @default(1)
  createdAt          DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  createdByUserId    String                      @map("created_by_user_id") @db.Uuid
  updatedAt          DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedByUserId    String                      @map("updated_by_user_id") @db.Uuid
  patient            User                        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  preferences        ProfilePreferenceVersion[]
  processingLock     PatientProcessingLock?
  scheduleVersions   MonitoringScheduleVersion[]
  scheduledPeriods   ScheduledPeriod[]

  @@map("patient_profiles")
}

model MonitoringScheduleVersion {
  id                 String            @id @default(uuid()) @db.Uuid
  patientId          String            @map("patient_id") @db.Uuid
  version            Int
  monitoringTimezone String            @map("monitoring_timezone") @db.VarChar(255)
  effectiveBoundary  DateTime          @map("effective_boundary") @db.Timestamptz(6)
  lifecycle          ScheduleLifecycle @default(ACTIVE)
  supersededAt       DateTime?         @map("superseded_at") @db.Timestamptz(6)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  createdByUserId    String            @map("created_by_user_id") @db.Uuid
  provenance         String?           @db.Text
  profile            PatientProfile    @relation(fields: [patientId], references: [patientId], onDelete: Restrict)
  periods            ScheduledPeriod[]

  @@unique([patientId, version], map: "monitoring_schedule_versions_patient_version_key")
  @@index([patientId, effectiveBoundary, version], map: "monitoring_schedule_versions_effective_idx")
  @@map("monitoring_schedule_versions")
}

enum ScheduleLifecycle {
  ACTIVE
  PENDING
  SUPERSEDED
}

model ScheduledPeriod {
  id                 String                    @id @default(uuid()) @map("period_id") @db.Uuid
  patientId          String                    @map("patient_id") @db.Uuid
  scheduleVersionId  String                    @map("schedule_version_id") @db.Uuid
  monitoringTimezone String                    @map("monitoring_timezone") @db.VarChar(255)
  periodStartAt      DateTime                  @map("period_start_at") @db.Timestamptz(6)
  periodEndAt        DateTime                  @map("period_end_at") @db.Timestamptz(6)
  openAt             DateTime                  @map("open_at") @db.Timestamptz(6)
  originalDueAt      DateTime                  @map("original_due_at") @db.Timestamptz(6)
  effectiveDueAt     DateTime                  @map("effective_due_at") @db.Timestamptz(6)
  version            Int                       @default(1)
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  profile            PatientProfile            @relation(fields: [patientId], references: [patientId], onDelete: Restrict)
  scheduleVersion    MonitoringScheduleVersion @relation(fields: [scheduleVersionId], references: [id], onDelete: Restrict)
  rescheduleAudits   PeriodRescheduleAudit[]

  @@unique([patientId, periodStartAt], map: "scheduled_periods_patient_start_key")
  @@index([patientId, periodEndAt], map: "scheduled_periods_patient_end_idx")
  @@map("scheduled_periods")
}

model PeriodRescheduleAudit {
  id                   String          @id @default(uuid()) @db.Uuid
  periodId             String          @map("period_id") @db.Uuid
  previousEffectiveDue DateTime        @map("previous_effective_due") @db.Timestamptz(6)
  newEffectiveDue      DateTime        @map("new_effective_due") @db.Timestamptz(6)
  actorUserId          String          @map("actor_user_id") @db.Uuid
  reason               String          @db.Text
  occurredAt           DateTime        @default(now()) @map("occurred_at") @db.Timestamptz(6)
  period               ScheduledPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)

  @@index([periodId, occurredAt], map: "period_reschedule_audits_period_idx")
  @@map("period_reschedule_audits")
}

model ProfilePreferenceVersion {
  id                         String                      @id @default(uuid()) @db.Uuid
  patientId                  String                      @map("patient_id") @db.Uuid
  version                    Int
  mutualHelpPreference       MutualHelpPreference?       @map("mutual_help_preference")
  spiritualContentPreference SpiritualContentPreference? @map("spiritual_content_preference")
  createdAt                  DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  createdByUserId            String                      @map("created_by_user_id") @db.Uuid
  profile                    PatientProfile              @relation(fields: [patientId], references: [patientId], onDelete: Restrict)

  @@unique([patientId, version], map: "profile_preference_versions_patient_version_key")
  @@index([patientId, version(sort: Desc)], map: "profile_preference_versions_latest_idx")
  @@map("profile_preference_versions")
}

model ClinicianPatientAssignment {
  id               String    @id @default(uuid()) @db.Uuid
  clinicianUserId  String    @map("clinician_user_id") @db.Uuid
  patientId        String    @map("patient_id") @db.Uuid
  version          Int       @default(1)
  assignedAt       DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)
  assignedByUserId String    @map("assigned_by_user_id") @db.Uuid
  assignmentReason String    @map("assignment_reason") @db.Text
  endedAt          DateTime? @map("ended_at") @db.Timestamptz(6)
  endedByUserId    String?   @map("ended_by_user_id") @db.Uuid
  endReason        String?   @map("end_reason") @db.Text
  clinician        User      @relation("ClinicianAssignments", fields: [clinicianUserId], references: [id], onDelete: Restrict)
  patient          User      @relation("PatientAssignments", fields: [patientId], references: [id], onDelete: Restrict)

  @@index([clinicianUserId, endedAt], map: "clinician_patient_assignments_clinician_active_idx")
  @@index([patientId, endedAt], map: "clinician_patient_assignments_patient_active_idx")
  @@map("clinician_patient_assignments")
}

enum RoutingLifecycle {
  DRAFT
  ACTIVE
  SUPERSEDED
}

enum RoutingTargetKind {
  EMERGENCY_SERVICE
  CRISIS_SERVICE
  URGENT_MEDICAL_SERVICE
  ON_CALL_CLINICIAN_QUEUE
}

enum RoutingTargetRepresentation {
  TELEPHONE
  DEEP_LINK
  INTERNAL_QUEUE
  EXTERNAL_SERVICE
}

enum RoutingTestResult {
  PASS
  FAIL
}

model RegionalRoutingProfileVersion {
  id                    String                        @id @default(uuid()) @db.Uuid
  countryCode           String                        @map("country_code") @db.VarChar(2)
  regionCode            String?                       @map("region_code") @db.VarChar(64)
  regionKey             String                        @map("region_key") @db.VarChar(128)
  logicalVersion        Int                           @map("logical_version")
  rowVersion            Int                           @default(1) @map("row_version")
  configurationRevision Int                           @default(1) @map("configuration_revision")
  lifecycle             RoutingLifecycle              @default(DRAFT)
  effectiveAt           DateTime?                     @map("effective_at") @db.Timestamptz(6)
  supersededAt          DateTime?                     @map("superseded_at") @db.Timestamptz(6)
  createdAt             DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  createdByUserId       String                        @map("created_by_user_id") @db.Uuid
  provenance            String?                       @db.Text
  targets               RegionalRoutingTarget[]
  testEvidence          RegionalRoutingTestEvidence[]

  @@unique([regionKey, logicalVersion], map: "regional_routing_profiles_region_version_key")
  @@index([regionKey, lifecycle, effectiveAt], map: "regional_routing_profiles_lookup_idx")
  @@map("regional_routing_profile_versions")
}

model RegionalRoutingTarget {
  id             String                        @id @default(uuid()) @db.Uuid
  profileId      String                        @map("profile_id") @db.Uuid
  kind           RoutingTargetKind
  representation RoutingTargetRepresentation
  targetValue    String                        @map("target_value") @db.Text
  label          String                        @db.VarChar(255)
  profile        RegionalRoutingProfileVersion @relation(fields: [profileId], references: [id], onDelete: Restrict)
  testEvidence   RegionalRoutingTestEvidence[]

  @@unique([profileId, kind], map: "regional_routing_targets_profile_kind_key")
  @@map("regional_routing_targets")
}

model RegionalRoutingTestEvidence {
  id                    String                        @id @default(uuid()) @db.Uuid
  profileId             String                        @map("profile_id") @db.Uuid
  targetId              String                        @map("target_id") @db.Uuid
  targetKind            RoutingTargetKind             @map("target_kind")
  configurationRevision Int                           @map("configuration_revision")
  result                RoutingTestResult
  provenance            String                        @db.Text
  testedAt              DateTime                      @map("tested_at") @db.Timestamptz(6)
  testedByUserId        String                        @map("tested_by_user_id") @db.Uuid
  profile               RegionalRoutingProfileVersion @relation(fields: [profileId], references: [id], onDelete: Restrict)
  target                RegionalRoutingTarget         @relation(fields: [targetId], references: [id], onDelete: Restrict)

  @@index([profileId, configurationRevision, targetKind, testedAt], map: "regional_routing_evidence_current_idx")
  @@map("regional_routing_test_evidence")
}
