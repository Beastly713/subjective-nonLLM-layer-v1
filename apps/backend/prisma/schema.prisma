  recoveryGoalVersion             RecoveryGoalVersion           @relation(fields: [recoveryGoalVersionId], references: [id], onDelete: Restrict, map: "weekly_consumption_summaries_goal_fk")
  baselineRevision                ReductionBaselineRevision?    @relation(fields: [baselineRevisionId], references: [id], onDelete: Restrict, map: "weekly_consumption_summaries_baseline_fk")

  @@unique([assessmentRevisionId], map: "weekly_consumption_summaries_revision_key")
  @@index([patientId, scheduledPeriodId], map: "weekly_consumption_summaries_patient_period_idx")
  @@map("weekly_consumption_summaries")
}

