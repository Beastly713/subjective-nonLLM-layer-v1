generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model IdempotencyRecord {
  id                 String   @id @default(uuid()) @db.Uuid
  actorId            String   @map("actor_id") @db.Uuid
  action             String   @db.VarChar(128)
  idempotencyKey     String   @map("idempotency_key") @db.VarChar(255)
  requestPayloadHash String   @map("request_payload_hash") @db.VarChar(128)
  responseStatus     Int?     @map("response_status")
  responseSnapshot   Json?    @map("response_snapshot")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt          DateTime @map("expires_at") @db.Timestamptz(6)
  actor              User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([actorId, action, idempotencyKey], map: "idempotency_records_actor_action_key_key")
  @@index([expiresAt], map: "idempotency_records_expires_at_idx")
  @@map("idempotency_records")
}

model PatientProcessingLock {
  patientId String         @id @map("patient_id") @db.Uuid
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  profile   PatientProfile @relation(fields: [patientId], references: [patientId], onDelete: Restrict)

  @@map("patient_processing_locks")
}

model AuditEvent {
  eventId                 String   @id @default(uuid()) @map("event_id") @db.Uuid
  actorId                 String?  @map("actor_id") @db.Uuid
  actorRole               String?  @map("actor_role") @db.VarChar(64)
  actorContext            Json?    @map("actor_context")
  action                  String   @db.VarChar(128)
  entityType              String   @map("entity_type") @db.VarChar(128)
  entityId                String?  @map("entity_id") @db.VarChar(255)
  patientId               String?  @map("patient_id") @db.Uuid
  occurredAt              DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  reason                  String?  @db.Text
  ruleSetVersion          String?  @map("rule_set_version") @db.VarChar(128)
  instrumentVersion       String?  @map("instrument_version") @db.VarChar(64)
  configurationVersion    String?  @map("configuration_version") @db.VarChar(128)
  sourceRevisionReference String?  @map("source_revision_reference") @db.VarChar(255)
  metadata                Json?
  requestId               String?  @map("request_id") @db.VarChar(128)

  @@index([patientId, occurredAt], map: "audit_events_patient_id_occurred_at_idx")
  @@index([entityType, entityId, occurredAt], map: "audit_events_entity_occurred_at_idx")
  @@index([actorId, occurredAt], map: "audit_events_actor_id_occurred_at_idx")
  @@map("audit_events")
}

model OperationalIncident {
  id                  String    @id @default(uuid()) @db.Uuid
  incidentType        String    @map("incident_type") @db.VarChar(128)
  code                String    @db.VarChar(128)
  status              String    @db.VarChar(64)
  summary             String    @db.Text
  metadata            Json?
  requestId           String?   @map("request_id") @db.VarChar(128)
  provenanceReference String?   @map("provenance_reference") @db.VarChar(255)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  resolvedAt          DateTime? @map("resolved_at") @db.Timestamptz(6)

  @@index([status, createdAt], map: "operational_incidents_status_created_at_idx")
  @@map("operational_incidents")
}

model User {
  id                   String                       @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  name                 String
  email                String                       @unique
  emailVerified        Boolean                      @default(false)
  image                String?
  createdAt            DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                     @updatedAt @db.Timestamptz(6)
  twoFactorEnabled     Boolean?                     @default(false)
  sessions             Session[]
  accounts             Account[]
  twoFactors           TwoFactor[]
  applicationAccount   ApplicationAccount?
  roleAssignments      UserRoleAssignment[]
  patientProfile       PatientProfile?
  clinicianAssignments ClinicianPatientAssignment[] @relation("ClinicianAssignments")
  patientAssignments   ClinicianPatientAssignment[] @relation("PatientAssignments")
  idempotencyRecords   IdempotencyRecord[]

  @@map("user")
}

model Session {
  id        String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  expiresAt DateTime @db.Timestamptz(6)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(6)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  secret                  String
  backupCodes             String
  userId                  String    @db.Uuid
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime? @db.Timestamptz(6)

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

enum ApplicationAccountState {
  PENDING
  ACTIVE
  DISABLED
}

enum ApplicationWorkspace {
  PATIENT
  CLINICIAN
  ADMIN
}

enum ApplicationRole {
  PATIENT
  CLINICIAN
  ADMIN
  OPERATIONS
}

enum MutualHelpPreference {
  NONE
  AA_12_STEP
  ALTERNATIVE
  UNSURE
  PREFER_NOT_TO_SAY
}

enum SpiritualContentPreference {
  ALLOW
  DO_NOT_ALLOW
  UNSURE
}

model ApplicationAccount {
  userId                                  String                  @id @map("user_id") @db.Uuid
  state                                   ApplicationAccountState @default(PENDING)
  version                                 Int                     @default(1)
  createdAt                               DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  createdByUserId                         String                  @map("created_by_user_id") @db.Uuid
  disabledAt                              DateTime?               @map("disabled_at") @db.Timestamptz(6)
  disabledByUserId                        String?                 @map("disabled_by_user_id") @db.Uuid
  disableReason                           String?                 @map("disable_reason") @db.Text
  privilegedIdentityVerifiedAt            DateTime?               @map("privileged_identity_verified_at") @db.Timestamptz(6)
  privilegedIdentityVerifiedByUserId      String?                 @map("privileged_identity_verified_by_user_id") @db.Uuid
  privilegedIdentityVerificationReference String?                 @map("privileged_identity_verification_reference") @db.VarChar(255)
  user                                    User                    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("application_accounts")
}

model UserRoleAssignment {
  id              String               @id @default(uuid()) @db.Uuid
  userId          String               @map("user_id") @db.Uuid
  workspace       ApplicationWorkspace
  role            ApplicationRole
  version         Int                  @default(1)
  grantedAt       DateTime             @default(now()) @map("granted_at") @db.Timestamptz(6)
  grantedByUserId String               @map("granted_by_user_id") @db.Uuid
  grantReason     String               @map("grant_reason") @db.Text
  revokedAt       DateTime?            @map("revoked_at") @db.Timestamptz(6)
  revokedByUserId String?              @map("revoked_by_user_id") @db.Uuid
  revokeReason    String?              @map("revoke_reason") @db.Text
  user            User                 @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt], map: "user_role_assignments_user_active_idx")
  @@map("user_role_assignments")
}

model PatientProfile {
  patientId          String                      @id @map("patient_id") @db.Uuid
  monitoringTimezone String                      @map("monitoring_timezone") @db.VarChar(255)
  version            Int                         @default(1)
  createdAt          DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  createdByUserId    String                      @map("created_by_user_id") @db.Uuid
  updatedAt          DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedByUserId    String                      @map("updated_by_user_id") @db.Uuid
  patient            User                        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  preferences        ProfilePreferenceVersion[]
  processingLock     PatientProcessingLock?
  scheduleVersions   MonitoringScheduleVersion[]
  scheduledPeriods   ScheduledPeriod[]
  onboardingState    PatientOnboardingState?
  onboardingRevisions OnboardingRevision[]
  reductionSetupState ReductionSetupState?
  reductionBaselineRevisions ReductionBaselineRevision[]
  recoveryGoalVersions RecoveryGoalVersion[]
  safetyInputRevisions SafetyInputRevision[]
  safetyEvaluationResults SafetyEvaluationResult[]
  safetyCases SafetyCase[]
  weeklyAssessments WeeklyAssessment[]
  assessmentEvaluations AssessmentEvaluation[]
  useObservationLedger UseObservationLedger[]
  alcoholConsumptionDays AlcoholConsumptionDay[]
  weeklyConsumptionSummaries WeeklyConsumptionSummary[]
  stateFlagObservations StateFlagObservation[]
  currentStateFlags CurrentStateFlag[]
  aggregateContextRecords AggregateContextRecord[]
  longitudinalFeatureRecords LongitudinalFeatureRecord[]
  patientInterventionIntents PatientInterventionIntent[]

  @@map("patient_profiles")
}

model PatientOnboardingState {
  patientId                    String              @id @map("patient_id") @db.Uuid
  version                      Int                 @default(1)
  currentStep                  String              @map("current_step") @db.VarChar(64)
  draftResponses               Json                @map("draft_responses")
  authoritativeRevisionId      String?             @map("authoritative_revision_id") @db.Uuid
  completionStatus             OnboardingCompletionStatus @default(INCOMPLETE) @map("completion_status")
  completionSafetyEvaluationResultId String?       @map("completion_safety_evaluation_result_id") @db.Uuid
  completedAt                  DateTime?           @map("completed_at") @db.Timestamptz(6)
  completedByUserId            String?             @map("completed_by_user_id") @db.Uuid
  createdAt                    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  createdByUserId              String              @map("created_by_user_id") @db.Uuid
  updatedAt                    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedByUserId              String              @map("updated_by_user_id") @db.Uuid
  @@unique([authoritativeRevisionId], map: "patient_onboarding_states_authoritative_revision_key")
  profile                      PatientProfile      @relation(fields: [patientId], references: [patientId], onDelete: Restrict, map: "patient_onboarding_states_patient_fk")
  authoritativeRevision        OnboardingRevision? @relation(fields: [authoritativeRevisionId], references: [id], onDelete: Restrict, map: "patient_onboarding_states_revision_fk")
  completionSafetyEvaluationResult SafetyEvaluationResult? @relation("OnboardingCompletionSafetyEvaluation", fields: [completionSafetyEvaluationResultId], references: [id], onDelete: Restrict, map: "patient_onboarding_states_completion_safety_fk")
  @@map("patient_onboarding_states")
}

enum OnboardingCompletionStatus {
  INCOMPLETE
  PENDING_SAFETY_REVIEW
  SAFETY_HANDOFF
  COMPLETE
}

model OnboardingRevision {
  id                    String                 @id @default(uuid()) @db.Uuid
  patientId             String                 @map("patient_id") @db.Uuid
  revision              Int
  sourceDraftVersion    Int                    @map("source_draft_version")
  responseSnapshot      Json                   @map("response_snapshot")
  auditCInstrument      String                 @map("audit_c_instrument") @db.VarChar(128)
  auditCVersion         String                 @map("audit_c_version") @db.VarChar(64)
  auditCSource          String                 @map("audit_c_source") @db.Text
  schemaVersion         String                 @map("schema_version") @db.VarChar(64)
  submittedAt           DateTime               @default(now()) @map("submitted_at") @db.Timestamptz(6)
  submittingActorId     String                 @map("submitting_actor_id") @db.Uuid
  provenance            Json?
  profile               PatientProfile         @relation(fields: [patientId], references: [patientId], onDelete: Restrict, map: "onboarding_revisions_patient_fk")
  state                 PatientOnboardingState?
  safetyInputs          SafetyInputRevision[]
  recoveryGoalVersions  RecoveryGoalVersion[]
  @@unique([patientId, revision], map: "onboarding_revisions_patient_revision_key")
  @@map("onboarding_revisions")
}

enum AlcoholDayStatus {
  KNOWN_ZERO
  KNOWN_QUANTITY
  UNKNOWN
}

enum AlcoholThresholdProfile {
  LOWER_THRESHOLD
  HIGHER_THRESHOLD
}

enum ReductionBaselineLifecycle {
  DRAFT
  CONFIRMED
}

enum ReductionProposalKind {
  REDUCTION
  ABSTINENCE
}

model ReductionSetupState {
  patientId                         String                    @id @map("patient_id") @db.Uuid
  version                           Int                       @default(1)
  draftBaselineRevisionId           String?                   @map("draft_baseline_revision_id") @db.Uuid
  authoritativeBaselineRevisionId  String?                   @map("authoritative_baseline_revision_id") @db.Uuid
  proposalKind                      ReductionProposalKind?   @map("proposal_kind")
  targetWeeklyStandardDrinks        Decimal?                  @map("target_weekly_standard_drinks") @db.Decimal(12, 4)
  proposalBaselineRevisionId        String?                   @map("proposal_baseline_revision_id") @db.Uuid
  proposalUpdatedAt                 DateTime?                 @map("proposal_updated_at") @db.Timestamptz(6)
  proposalUpdatedByUserId           String?                   @map("proposal_updated_by_user_id") @db.Uuid
  createdAt                         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdByUserId                   String                    @map("created_by_user_id") @db.Uuid
  updatedAt                         DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedByUserId                   String                    @map("updated_by_user_id") @db.Uuid
  profile                           PatientProfile            @relation(fields: [patientId], references: [patientId], onDelete: Restrict, map: "reduction_setup_states_patient_fk")
  draftBaselineRevision             ReductionBaselineRevision? @relation("ReductionSetupDraftBaseline", fields: [draftBaselineRevisionId], references: [id], onDelete: Restrict, map: "reduction_setup_states_draft_baseline_fk")
  authoritativeBaselineRevision    ReductionBaselineRevision? @relation("ReductionSetupAuthoritativeBaseline", fields: [authoritativeBaselineRevisionId], references: [id], onDelete: Restrict, map: "reduction_setup_states_authoritative_baseline_fk")
  proposalBaselineRevision          ReductionBaselineRevision? @relation("ReductionSetupProposalBaseline", fields: [proposalBaselineRevisionId], references: [id], onDelete: Restrict, map: "reduction_setup_states_proposal_baseline_fk")

  @@map("reduction_setup_states")
}

model ReductionBaselineRevision {
  id                              String                     @id @default(uuid()) @db.Uuid
  patientId                       String                     @map("patient_id") @db.Uuid
  revision                        Int
  lifecycle                       ReductionBaselineLifecycle @default(DRAFT)
  baselineStart                   DateTime                   @map("baseline_start") @db.Date
  baselineEnd                     DateTime                   @map("baseline_end") @db.Date
  monitoringTimezone              String                     @map("monitoring_timezone") @db.VarChar(255)
  thresholdProfile                AlcoholThresholdProfile   @map("threshold_profile")
  thresholdProfileSource          String                     @map("threshold_profile_source") @db.VarChar(128)
  unitPolicyVersion               String                     @map("unit_policy_version") @db.VarChar(64)
  baselineTotalStandardDrinks28d  Decimal?                   @map("baseline_total_standard_drinks_28d") @db.Decimal(12, 4)
  baselineTotalEthanolGrams28d    Decimal?                   @map("baseline_total_ethanol_grams_28d") @db.Decimal(12, 4)
  baselineDrinkingDays28d         Int?                       @map("baseline_drinking_days_28d")
  baselineHeavyDrinkingDays28d    Int?                       @map("baseline_heavy_drinking_days_28d")
  baselineMaxStandardDrinksDay    Decimal?                   @map("baseline_max_standard_drinks_day") @db.Decimal(12, 4)
  baselineAverageDrinksPerDrinkingDay Decimal?                @map("baseline_average_drinks_per_drinking_day") @db.Decimal(12, 4)
  baselineAverageWeeklyDrinks     Decimal?                   @map("baseline_average_weekly_drinks") @db.Decimal(12, 4)
  correctionOfRevisionId           String?                    @map("correction_of_revision_id") @db.Uuid
  correctionReason                 String?                    @map("correction_reason") @db.Text
  createdAt                        DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdByUserId                  String                     @map("created_by_user_id") @db.Uuid
  confirmedAt                      DateTime?                  @map("confirmed_at") @db.Timestamptz(6)
  confirmedByUserId                String?                    @map("confirmed_by_user_id") @db.Uuid
  provenance                       Json?
  profile                          PatientProfile             @relation(fields: [patientId], references: [patientId], onDelete: Restrict, map: "reduction_baseline_revisions_patient_fk")
  recoveryGoalVersions             RecoveryGoalVersion[]
  setupStateDraft                  ReductionSetupState[]       @relation("ReductionSetupDraftBaseline")
  setupStateAuthoritative          ReductionSetupState[]       @relation("ReductionSetupAuthoritativeBaseline")
  setupStateProposal               ReductionSetupState[]       @relation("ReductionSetupProposalBaseline")
  correctionOf                     ReductionBaselineRevision? @relation("ReductionBaselineCorrections", fields: [correctionOfRevisionId], references: [id], onDelete: Restrict, map: "reduction_baseline_revisions_correction_fk")
  corrections                      ReductionBaselineRevision[] @relation("ReductionBaselineCorrections")
  days                             ReductionBaselineDay[]
  weeklyConsumptionSummaries       WeeklyConsumptionSummary[]

  @@unique([patientId, revision], map: "reduction_baseline_revisions_patient_revision_key")
  @@map("reduction_baseline_revisions")
}

model ReductionBaselineDay {
  id                    String                   @id @default(uuid()) @db.Uuid
  baselineRevisionId    String                   @map("baseline_revision_id") @db.Uuid
  localDate             DateTime                 @map("local_date") @db.Date
  status                AlcoholDayStatus
  standardDrinks        Decimal?                 @map("standard_drinks") @db.Decimal(12, 4)
  ethanolGrams          Decimal?                 @map("ethanol_grams") @db.Decimal(12, 4)
  source                String                   @db.VarChar(64)
  unitPolicyVersion     String                   @map("unit_policy_version") @db.VarChar(64)
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedByUserId       String                   @map("updated_by_user_id") @db.Uuid
  baselineRevision      ReductionBaselineRevision @relation(fields: [baselineRevisionId], references: [id], onDelete: Restrict, map: "reduction_baseline_days_revision_fk")

  @@unique([baselineRevisionId, localDate], map: "reduction_baseline_days_revision_date_key")
  @@map("reduction_baseline_days")
}

model SafetyInputRevision {
  id                    String                 @id @default(uuid()) @db.Uuid
  patientId             String                 @map("patient_id") @db.Uuid
  revision              Int
  sourceOnboardingRevisionId String?            @map("source_onboarding_revision_id") @db.Uuid
  inputSnapshot         Json                    @map("input_snapshot")
  instrument            String                  @db.VarChar(128)
  instrumentVersion     String                  @map("instrument_version") @db.VarChar(64)
  instrumentSource      String                  @map("instrument_source") @db.Text
  schemaVersion         String                  @map("schema_version") @db.VarChar(64)
  trigger               String                  @db.VarChar(64)
  actorId               String                  @map("actor_id") @db.Uuid
  submittedAt           DateTime                @default(now()) @map("submitted_at") @db.Timestamptz(6)
  profile               PatientProfile          @relation(fields: [patientId], references: [patientId], onDelete: Restrict, map: "safety_input_revisions_patient_fk")
  sourceOnboardingRevision OnboardingRevision? @relation(fields: [sourceOnboardingRevisionId], references: [id], onDelete: Restrict, map: "safety_input_revisions_onboarding_fk")
  evaluationResults     SafetyEvaluationResult[]
  @@unique([patientId, revision], map: "safety_input_revisions_patient_revision_key")
  @@map("safety_input_revisions")
}

model SafetyEvaluationResult {
  id                    String              @id @default(uuid()) @db.Uuid
  patientId             String              @map("patient_id") @db.Uuid
  safetyInputRevisionId String              @map("safety_input_revision_id") @db.Uuid
  severity              String              @db.VarChar(32)
  gateStatus            String              @map("gate_status") @db.VarChar(32)
  reasonCodes           Json                @map("reason_codes")
  safetyDomain          String?             @map("safety_domain") @db.VarChar(64)
  ownerRole             String?             @map("owner_role") @db.VarChar(64)
  clinicianContext      Boolean             @map("clinician_context")
  allowedSubjectiveInterventions Json       @map("allowed_subjective_interventions")
  monitoringPromptPolicy String              @map("monitoring_prompt_policy") @db.VarChar(32)
  goalChangeAllowed     Boolean             @map("goal_change_allowed")
  reassessmentDueAt     DateTime?           @map("reassessment_due_at") @db.Timestamptz(6)
  evaluatorVersion      String              @map("evaluator_version") @db.VarChar(64)
  configurationVersion  String              @map("configuration_version") @db.VarChar(64)
  evaluatedAt           DateTime             @default(now()) @map("evaluated_at") @db.Timestamptz(6)
  resultSnapshot        Json?                @map("result_snapshot")
  contextSnapshot       Json?                @map("evaluation_context_snapshot")
  profile               PatientProfile       @relation(fields: [patientId], references: [patientId], onDelete: Restrict, map: "safety_evaluation_results_patient_fk")
  safetyInputRevision   SafetyInputRevision  @relation(fields: [safetyInputRevisionId], references: [id], onDelete: Restrict, map: "safety_evaluation_results_input_fk")
  onboardingCompletionStates PatientOnboardingState[] @relation("OnboardingCompletionSafetyEvaluation")
  recoveryGoalVersions  RecoveryGoalVersion[]
  safetyCases           SafetyCase[]
  @@map("safety_evaluation_results")
}

enum SafetyCaseLifecycle {
  DETECTED
  HANDOFF_INITIATED
  ACKNOWLEDGED
  CLINICAL_REVIEW_IN_PROGRESS
  PLAN_ESTABLISHED
  RESOLVED
  ESCALATED_TO_EMERGENCY
  RESOLVED_EXTERNAL_HANDOFF
}
enum SafetyCaseDomain {
  WITHDRAWAL_OR_MEDICAL
  SUICIDE_OR_SELF_HARM
  PREGNANCY
  OTHER_SUBSTANCE
  ROUTINE_MEDICAL_CONTEXT
}
enum SafetyDisposition {
  SAFE_TO_CONTINUE_STANDARD_MONITORING
  SAFE_TO_CONTINUE_WITH_RESTRICTIONS
  CONTINUE_CLINICAL_HANDOFF
  EMERGENCY_EXTERNAL_MANAGEMENT
  MONITORING_TEMPORARILY_PAUSED
}
model SafetyCase {
  id String @id @default(uuid()) @db.Uuid
  patientId String @map("patient_id") @db.Uuid
  domain SafetyCaseDomain
  sourceSafetyEvaluationResultId String @map("source_safety_evaluation_result_id") @db.Uuid
  severity String @db.VarChar(32)
  gateStatus String @map("gate_status") @db.VarChar(32)
  ownerRole String @map("owner_role") @db.VarChar(64)
  lifecycle SafetyCaseLifecycle @default(DETECTED)
  version Int @default(1)
  detectedAt DateTime @default(now()) @map("detected_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)
  currentRestrictionVersionId String? @map("current_restriction_version_id") @db.Uuid
  currentRouteSnapshot Json? @map("current_route_snapshot")
  routeStatus String @map("route_status") @db.VarChar(32)
  routeProfileId String? @map("route_profile_id") @db.Uuid
  routeProfileLogicalVersion Int? @map("route_profile_logical_version")
  profile PatientProfile @relation(fields: [patientId], references: [patientId], onDelete: Restrict, map: "safety_cases_patient_fk")
  evaluation SafetyEvaluationResult @relation(fields: [sourceSafetyEvaluationResultId], references: [id], onDelete: Restrict, map: "safety_cases_evaluation_fk")
  currentRestriction SafetyCaseRestrictionVersion? @relation("SafetyCaseCurrentRestriction", fields: [currentRestrictionVersionId], references: [id], onDelete: Restrict, map: "safety_cases_current_restriction_fk")
  restrictions SafetyCaseRestrictionVersion[] @relation("SafetyCaseRestrictionHistory")
  dispositions SafetyCaseDisposition[]
  lifecycleEvents SafetyCaseLifecycleEvent[]
  @@map("safety_cases")
}
