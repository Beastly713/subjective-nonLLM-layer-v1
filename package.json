{
  "name": "aud-subjective-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "contracts:build": "pnpm --filter @aud-subjective/contracts run build",
    "predev": "pnpm contracts:build && pnpm db:generate",
    "dev": "pnpm --parallel --filter @aud-subjective/contracts --filter @aud-subjective/web --filter @aud-subjective/backend run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "pretypecheck": "pnpm contracts:build && pnpm db:generate",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm test:web && pnpm test:backend && pnpm test:e2e",
    "pretest:web": "pnpm contracts:build",
    "test:web": "pnpm --filter @aud-subjective/web run test",
    "pretest:backend": "pnpm contracts:build && pnpm db:generate",
    "test:backend": "vitest run apps/backend/test/integration",
    "test:e2e": "pnpm build && pnpm test:e2e:run",
    "test:e2e:run": "playwright test",
    "prebuild": "pnpm contracts:build && pnpm db:generate",
    "build": "pnpm --recursive run build",
    "db:generate": "pnpm --filter @aud-subjective/backend run db:generate",
    "db:migrate:dev": "pnpm --filter @aud-subjective/backend run db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @aud-subjective/backend run db:migrate:deploy",
    "db:seed": "pnpm --filter @aud-subjective/backend run db:seed"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
